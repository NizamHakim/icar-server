{
  "name": "icar-server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run prisma:generate && npm run migrate:deploy",
    "start": "node ./dist/src/index.js",
    "dev": "tsx watch ./src/index.ts",
    "migrate:deploy": "npx prisma migrate deploy && npx prisma db seed",
    "migrate:dev": "npx prisma migrate dev && npx prisma db seed",
    "migrate:drop": "rm -rf prisma/migrations && npx prisma migrate reset --force",
    "migrate:fresh": "npm run migrate:drop && npx prisma migrate dev --name init && npx prisma db seed",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --port 5556",
    "test:mockIcar": "tsx ./src/test/icarMock.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.6.1",
    "node-cron": "^4.1.0",
    "pg": "^8.18.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.19.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "prisma": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}

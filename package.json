{
	"name": "icar-server",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"build": "tsc && npm run prisma:generate && npm run migrate:drop && npm run migrate:deploy",
		"start": "node ./dist/src/index.js",
		"dev": "nodemon --files ./src/index.ts",
		"migrate:deploy": "npx prisma migrate deploy && npx prisma db seed",
		"migrate:dev": "npx prisma migrate dev && npx prisma db seed",
		"migrate:drop": "rm -rf prisma/migrations && npx prisma migrate reset --force --skip-seed",
		"migrate:fresh": "npm run migrate:drop && npx prisma migrate dev --name init && npx prisma db seed",
		"prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
		"prisma:studio": "npx prisma studio --port 5556",
		"test:mockIcar": "ts-node ./src/utils/icar_mock.ts",
		"test:refreshSchedule": "ts-node ./prisma/seeder/refreshSchedule.ts",
		"mode:dev": "cp .env.dev .env",
		"mode:test": "cp .env.prod .env"
	},
	"prisma": {
		"seed": "ts-node prisma/seeder/seed.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"@prisma/client": "^6.7.0",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.5",
		"dotenv": "^17.2.0",
		"express": "^5.1.0",
		"express-validator": "^7.2.1",
		"jsonwebtoken": "^9.0.2",
		"luxon": "^3.6.1",
		"node-cron": "^4.1.0",
		"prisma": "^6.7.0",
		"ws": "^8.18.2"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.18",
		"@types/express": "^5.0.1",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/luxon": "^3.6.2",
		"@types/node": "^22.15.16",
		"@types/node-cron": "^3.0.11",
		"@types/ws": "^8.18.1",
		"nodemon": "^3.1.10",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.4",
		"typescript": "^5.8.3"
	}
}
